From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mark Brand <mabrand@mabrand.nl>
Date: Wed, 23 Sep 2026 21:49:57 +0200
Subject: [PATCH 2/2] add -fext-numeric-literals to CFLAGS, including in .pc
 file


diff --git a/meson.build b/meson.build
index 1111111..2222222 100644
--- a/meson.build
+++ b/meson.build
@@ -99,6 +99,7 @@ elif host_system == 'windows'
   platform_cflags += ['-DNOMINMAX']
   # Ensure M_PI etc are defined
   platform_cflags += ['-D_USE_MATH_DEFINES']
+  platform_cflags += ['-fext-numeric-literals']
   os_deps += [cc.find_library('winmm')]
   have_win = true
 endif
