Contains ad hoc patches for cross building.

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Marco Borrini <borrinimarco74@gmail.com>
Date: Wed, 29 Oct 2026 17:50:00 +0100
Subject: [PATCH 1/1] glib: fix intsafe overflow checks, flag_enum and static libintl iconv dependency on GCC 4

diff --git a/glib/gmacros.h b/glib/gmacros.h
index 1111111..2222222 100644
--- a/glib/gmacros.h
+++ b/glib/gmacros.h
@@ -196,6 +196,7 @@
 #define g_macro__has_attribute_warn_unused_result G_GNUC_CHECK_VERSION (3, 4)
 #define g_macro__has_attribute_no_sanitize_address 0
 #define g_macro__has_attribute_ifunc 0
+#define g_macro__has_attribute_flag_enum 0

 #endif

diff --git a/glib/gtypes.h b/glib/gtypes.h
index 1111111..2222222 100644
--- a/glib/gtypes.h
+++ b/glib/gtypes.h
@@ -455,7 +455,7 @@
 #define _GLIB_HAVE_BUILTIN_OVERFLOW_CHECKS
 #elif g_macro__has_builtin(__builtin_add_overflow)
 #define _GLIB_HAVE_BUILTIN_OVERFLOW_CHECKS
-#elif defined(G_OS_WIN32) && defined(HAVE_INTSAFE_H)
+#elif defined(G_OS_WIN32) && defined(HAVE_INTSAFE_H) && !defined(__MINGW32__)
 #define _GLIB_HAVE_INTSAFE_OVERFLOW_CHECKS
 #endif
 #endif
diff --git a/meson.build b/meson.build
index 1111111..2222222 100644
--- a/meson.build
+++ b/meson.build
@@ -2329,15 +2329,16 @@ if libintl.found() and libintl.type_name() != 'internal'
   #
   # Meson's builtin dependency lookup as of 0.60.0 doesn't check for
   # pthread, so we do this manually here.
-  if cc.has_function('ngettext', dependencies : libintl, prefix: libintl_prefix)
+  libintl_test_code = libintl_prefix + '\nint main(void) { return gettext("") != 0; }'
+  if cc.links(libintl_test_code, dependencies : libintl)
     libintl_deps += [libintl]
   else
     libintl_iconv = cc.find_library('iconv', required : false)
-    if libintl_iconv.found() and cc.has_function('ngettext', args : osx_ldflags, dependencies : [libintl, libintl_iconv])
+    if libintl_iconv.found() and cc.links(libintl_test_code, args : osx_ldflags, dependencies : [libintl, libintl_iconv])
       libintl_deps += [libintl, libintl_iconv]
     else
       libintl_pthread = cc.find_library('pthread', required : false)
-      if libintl_pthread.found() and cc.has_function('ngettext', dependencies : [libintl, libintl_pthread], prefix: libintl_prefix)
+      if libintl_pthread.found() and cc.links(libintl_test_code, dependencies : [libintl, libintl_pthread])
         libintl_deps += [libintl, libintl_pthread]
       else
         libintl = disabler()
