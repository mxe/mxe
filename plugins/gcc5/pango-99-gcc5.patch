From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Marco Borrini <borrinimarco74@gmail.com>
Date: Fri, 30 Oct 2026 17:50:00 +0100
Subject: [PATCH 1/1] pango: set cpp_std=c++11 for GCC 5 compatibility

diff --git a/meson.build b/meson.build
index 9a5dc9e..1897cce 100644
--- a/meson.build
+++ b/meson.build
@@ -5,6 +5,7 @@ project('pango', 'c', 'cpp',
           'buildtype=debugoptimized',
           'warning_level=1',
           'c_std=gnu11',
+          'cpp_std=c++11',
         ],
         meson_version : '>= 1.2.0')
